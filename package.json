{
  "name": "vaultwarden-android-addon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "lint:ext": "web-ext lint -s dist",
    "start:android": "web-ext run -t firefox-android -s dist"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "web-ext": "^8.3.0",
    "@types/firefox-webext-browser": "^120.0.0"
  },
  "dependencies": {
    "hash-wasm": "^4.11.0"
  }
}
